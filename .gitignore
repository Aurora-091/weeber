.env
.env.development.local
.env.test.local
.env.production.local
.env.local
.env*.local
.env.railway
.env.git

# caches
.eslintcache
.cache
*.tsbuildinfo
.turbo

# IntelliJ based IDEs
.idea

# VS Code editor settings
.vscode/

# macOS
.DS_Store

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# scripts (local-only provisioning)
scripts/
# ...except packages/api/scripts — that's the real, committed latency
# benchmark tool (§2b), not a local-only provisioning script.
!packages/api/scripts/
!packages/api/scripts/**
.git-push.env
task.md

# Repo is Bun-only (bun.lock is the source of truth) — npm/yarn lockfiles keep getting
# reintroduced by editor tooling/IDE auto-install (removed 4x already: a9c037f, 39bd706, b09b778,
# 9471e62) and break Railway's Nixpacks build (it detects both lockfiles and runs `npm ci`, which
# aborts if package-lock.json is out of sync with package.json — exactly what happened 2026-07-18
# after adding Sentry). Never commit these again.
package-lock.json
yarn.lock


# Cloudflare named-tunnel credential (per ADR-013) — never commit
.cloudflare-tunnel-token

# Local GitHub token used for pushing from the sandbox — never commit
.env.github
community-posts-draft.md
reddit-feedback.md

# Generated by the a11y suite (packages/web/e2e-visual/a11y.spec.ts) — CI artifact, not source.
a11y-out/
a11y-report.json

# Local audit credentials (Railway token, direct DATABASE_URL) — never commit
.env.audit
