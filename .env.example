NODE_ENV=development

# Database — Supabase Postgres (ADR-034). Use the pooled (transaction-mode,
# port 6543) connection string from the Supabase dashboard; auth lives
# inside the URL.
DATABASE_URL=
# Optional — this replica's own client-side connection pool size to the
# Supabase pooler (default: 20). If you ever run more than one replica,
# the real ceiling is (replica count × this value) against Supabase's own
# pooler client-connection limit for your compute tier — see
# docs/reference/resources.md's Supabase section before raising both at once.
DATABASE_POOL_MAX=
# Optional — ADR-116 addendum: pool size for the separate `dbBackground`
# connection (sweeps, admin dashboard, analytics — never a live call's turn
# path), same DATABASE_URL, kept apart so a saturated background workload
# can't queue out a live call's latency-critical writes. Default: 8.
DATABASE_POOL_MAX_BACKGROUND=

# AI Gateway (LLM) — e.g. Vercel AI Gateway: https://ai-gateway.vercel.sh/v1
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
# Optional — gateway model id (default: openai/gpt-5.4-mini)
AI_GATEWAY_MODEL=
# Cross-provider LLM failover (2026-07-17, recommendation #1 of
# docs/product-strategy/product-infra-and-gtm-report.md Part 4) — comma-separated AI Gateway model ids added as
# providerOptions.gateway.models fallbacks (native Vercel AI Gateway support, not a custom retry
# wrapper — see voice/llm/index.ts's buildGatewayProviderOptions). Only takes effect when
# LLM_PROVIDER=gateway below; Groq has no equivalent multi-model failover today.
AI_GATEWAY_FALLBACK_MODELS=

# Groq (optional alternative LLM provider — LPU inference, much faster than typical GPU-hosted
# models, at the cost of no cross-provider failover; see LLM_PROVIDER below for the tradeoff)
GROQ_API_KEY=

# OpenAI, Anthropic, OpenRouter (2026-08-27) — same shape as Groq above: direct SDK transports,
# no gateway hop, no gateway-native failover. Each is entirely optional and unrelated to the
# others — an org can only be pointed at one of these (org_agent_configs.llm_provider) once its
# key is set here; until then it simply doesn't appear as a choice anywhere (the admin dashboard's
# LLM-provider dropdown and GET /api/health's keysConfigured/configuredLlmProviders both read
# presence directly off these three vars — see voice/llm/index.ts's isLlmProviderConfigured).
OPENAI_API_KEY=
# Optional — OpenAI model id when LLM_PROVIDER=openai or an agent is set to it (default: gpt-5.4-mini)
OPENAI_MODEL=
ANTHROPIC_API_KEY=
# Optional — Anthropic model id (default: claude-sonnet-5)
ANTHROPIC_MODEL=
# OpenRouter — one API key routing to many upstream vendors' models; speaks the OpenAI
# chat-completions wire format, so it reuses the OpenAI SDK client pointed at OpenRouter's base URL.
OPENROUTER_API_KEY=
# Optional — OpenRouter model id, provider-prefixed per OpenRouter's own convention (default: openai/gpt-5.4-mini)
OPENROUTER_MODEL=

# Which LLM provider is active by default: "gateway" (supports AI_GATEWAY_FALLBACK_MODELS above),
# "groq", "openai", "anthropic", or "openrouter" (lower latency than gateway, no cross-provider
# failover). Unset = gateway. Per-agent org_agent_configs.llm_provider overrides this default.
LLM_PROVIDER=

# Deepgram (real-time speech-to-text)
DEEPGRAM_API_KEY=

# Sarvam (Indic-language speech-to-text + text-to-speech — Saaras v3 STT, Bulbul v3 TTS)
SARVAM_API_KEY=

# ElevenLabs (real-time text-to-speech, and Scribe v2 Realtime speech-to-text)
ELEVENLABS_API_KEY=
# NOTE: there is deliberately no ELEVENLABS_VOICE_ID / CARTESIA_VOICE_ID / SARVAM_VOICE_ID.
# A voice is an agent property, not a deployment property: it is picked per agent
# (org_agent_configs.voice_provider + voice_id) and each provider's fallback voice is a
# code constant in packages/api/src/voice/tts/default-voices.ts. See ADR-102.
# Optional — pronunciation dictionary for domain terms (COD, UPI, KYC, etc.) that get
# mispronounced by default. Both required together; omitted = no dictionary applied (safe
# no-op). Create via POST /v1/pronunciation-dictionaries/add-from-rules — see
# docs/voice-quality/hindi-hinglish-voice-support.md Phase 3 for the exact terms/rules used and how this
# was live-verified (real before/after fix: "COD" was being misheard as "card" without it).
ELEVENLABS_PRONUNCIATION_DICTIONARY_ID=
ELEVENLABS_PRONUNCIATION_DICTIONARY_VERSION_ID=

# Cartesia (real-time text-to-speech — Sonic model)
CARTESIA_API_KEY=

# Which STT/TTS provider is active by default (per-call/per-agent override always wins —
# see agent-frame.ts's sttProvider/voiceProvider). STT_PROVIDER: "deepgram" (default) |
# "sarvam" | "elevenlabs". TTS_PROVIDER: "cartesia" (default — works on free/starter tiers
# without ElevenLabs' library-voice restriction) | "elevenlabs" | "sarvam".
STT_PROVIDER=deepgram
TTS_PROVIDER=cartesia

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public HTTPS URL Twilio can reach (wss derived automatically for the media stream)
# — this is the API's OWN origin (Railway), not a browser-facing site.
PUBLIC_APP_URL=

# Browser-facing marketing-site origin — used for links that must land on a
# web page a human opens (e.g. waitlist referral links). Distinct from
# PUBLIC_APP_URL on split deploys, where the API origin serves no frontend.
PUBLIC_WEB_URL=https://www.weeber.ai

# Browser-facing USER app origin — used for links that must land on the
# user dashboard specifically (e.g. weebersh's Shopify OAuth return_url,
# see buildInstallUrl in voice/org-queries.ts). Distinct from PUBLIC_WEB_URL
# (marketing site) and PUBLIC_APP_URL (this API's own origin) — a user
# finishing Shopify OAuth needs to land on app.weeber.ai, not either of
# those. Falls back to the old PUBLIC_MERCHANT_APP_URL name for one release,
# then PUBLIC_APP_URL as a last resort (wrong on any real split deploy — dead
# link, no frontend behind that origin) — always set this explicitly in
# production. Renamed from PUBLIC_MERCHANT_APP_URL 2026-07-17 (ADR-052
# Merchant→User follow-up).
PUBLIC_USER_APP_URL=https://app.weeber.ai

# --- Backend/frontend split deploy (ADR-035) ---
# Backend side: comma-separated origin allowlist for CORS. Unset = reflect any
# origin (single-deploy behavior). Set before the Vercel frontend goes live.
CORS_ALLOWED_ORIGINS=https://www.weeber.ai,https://admin.weeber.ai,https://app.weeber.ai
# Frontend side (build-time, Vite): the Railway backend's origin. Unset =
# same-origin (single-deploy). Set in Vercel's env, not Railway's.
VITE_API_BASE_URL=

# Optional — default webhook target for n8n/Zapier/Make call-event notifications
WEBHOOK_URL=

# Legacy bootstrap admin key — always accepted alongside labeled admin keys, never removed
ADMIN_API_KEY=

# Optional — Redis-backed session storage for running more than one instance.
# Leave unset to keep the default in-memory session store (zero behavior change).
REDIS_URL=

# --- Weeber Shopify vertical (ADR-030) ---
# Shared secrets with the weebersh connector app (github.com/Aurora-091/weebersh)
# — see docs/reference/contract.md. Distinct secrets per direction so each can be rotated
# independently.
WEEBER_INTERNAL_SECRET=
WEEBER_CALLBACK_SECRET=
WEEBERSH_APP_URL=
# weebersh's Shopify app OAuth entrypoint (e.g. https://weebersh.up.railway.app/auth/shopify)
WEEBERSH_INSTALL_URL=

# Shopify vertical playbook tuning (all optional, sane defaults in code)
SHOPIFY_CART_RECOVERY_DELAY_MINUTES=45
SHOPIFY_CART_RECOVERY_MAX_ATTEMPTS=2
SHOPIFY_COD_DELAY_MINUTES=30
SHOPIFY_COD_MAX_ATTEMPTS=3
SHOPIFY_FEEDBACK_DELAY_DAYS=3

# --- Supabase (Auth + Postgres/pgvector) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: HS256 shared secret for pre-2025 Supabase projects. When unset,
# user JWT verification falls back to JWKS (asymmetric, via SUPABASE_URL).
# SUPABASE_JWT_SECRET=

# --- Sentry (error monitoring) ---
# DSN from a free Sentry.io project (Platform: Bun or Node). When unset, error
# monitoring silently no-ops — same convention as RESEND_API_KEY below. This is
# the one genuine error-visibility gap identified in
# docs/product-strategy/infra-consolidation-audit-2026-07-18.md: errors
# currently only go to console -> Railway logs (30-day retention, no
# aggregation, no alerts). Vercel Observability (already on Pro) only sees the
# frontend, not this Railway-hosted API where the voice pipeline lives.
SENTRY_DSN=

# --- Resend (transactional email) ---
# API key from Resend dashboard; when unset, transactional emails silently skip.
RESEND_API_KEY=
# Verified sender (default: hello@weeber.ai)
RESEND_FROM_EMAIL=hello@weeber.ai
# Sender for admin-authored broadcasts (dashboard/broadcasts.tsx) — unified with
# RESEND_FROM_EMAIL by default; override only if broadcasts should use a distinct address.
BROADCAST_FROM_EMAIL=hello@weeber.ai
# NOTE: this covers our own transactional emails (waitlist, support, broadcasts) only.
# Supabase Auth's own emails (signup confirmation/OTP, magic-link sign-in code, password
# reset) are sent by Supabase directly, not through this app — see
# packages/api/scripts/configure-supabase-auth-emails.ts to route those through Resend too.

# --- Cloudflare Turnstile (CAPTCHA for the public demo-call widget) ---
# Real demo-call widget (2026-08-27, docs/product-strategy/real-demo-call-widget-plan-2026-08-26.md).
# Secret key, used server-side by voice/turnstile.ts to verify a token before
# POST /api/public/demo-call is allowed to place a real outbound call. When unset,
# verifyTurnstileToken fails CLOSED (refuses every token) rather than skipping the check.
TURNSTILE_SECRET_KEY=
# Site key, embedded in the widget's Turnstile script (packages/web) — public by design,
# unlike the secret key above.
VITE_TURNSTILE_SITE_KEY=

# Rate-limit tiers, each optional — unset = the conservative launch defaults (2/day/IP,
# 1/day/phone, 50/day global). Raise these for a testing pass without a code deploy; lower
# them back before real public traffic. See voice/demo-widget-constants.ts.
# DEMO_WIDGET_MAX_PER_IP_PER_DAY=
# DEMO_WIDGET_MAX_PER_PHONE_PER_DAY=
# DEMO_WIDGET_MAX_GLOBAL_PER_DAY=

# --- Frontend build-time surface control ---
# "all" (default) = single bundle with all routes (landing + admin + user).
# "public" = marketing pages only (landing, docs).
# "admin" = /dashboard/* only (internal admin panel).
# "user" = /app/* only (user-facing product).
# Use separate Vercel projects per surface for subdomain isolation.
VITE_APP_SURFACE=all

# --- Cross-subdomain origins (production only, leave unset in local dev) ---
# Set these per Vercel project so cross-surface links resolve correctly.
# Unset = same-origin relative paths (local dev / VITE_APP_SURFACE=all).
VITE_WWW_ORIGIN=https://www.weeber.ai
VITE_ADMIN_ORIGIN=https://admin.weeber.ai
VITE_APP_ORIGIN=https://app.weeber.ai

# --- Crawler indexing (production only) ---
# Static <meta name="robots"> content baked into index.html at build time (Vite's
# %VAR% HTML env replacement) + drives vite.config.ts's robots.txt generation.
# Default here is the permissive public-marketing value. The admin and user
# Vercel projects MUST override this to "noindex, nofollow" -- their pages should
# never be indexed, and once they serve bare paths (no /dashboard or /app prefix)
# the shared public robots.txt's path-based Disallow rules no longer cover them.
VITE_ROBOTS_META=index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1

# --- LLM / knowledge base tuning (all optional) ---
# Groq model id when LLM_PROVIDER=groq (default: llama-3.3-70b-versatile)
GROQ_MODEL=
# Embedding model used by the knowledge base (default: openai/text-embedding-3-small)
AI_GATEWAY_EMBEDDING_MODEL=
# "true" enables the cross-transport LLM failover chain (voice/llm/transport-chain.ts).
# Off by default: with the flag off the whole fallback list is handed to the gateway instead.
LLM_TRANSPORT_FAILOVER=

# --- Per-number behavior overrides (all optional, JSON) ---
# Per-number provider/duration overrides — see docs/reference/configuration.md
NUMBER_CONFIG=
# Per-number persona overrides — see docs/reference/configuration.md
AGENT_PERSONAS=
# Outcome-driven follow-up automation — see docs/reference/configuration.md
WORKFLOWS=

# --- Compliance (packages/weeber-compliance) ---
# "hipaa" enables the HIPAA boot guardrail; anything else = standard mode.
COMPLIANCE_MODE=
# Required to be "true" when COMPLIANCE_MODE=hipaa, or the process refuses to boot.
HIPAA_BAA_CONFIRMED=
# Retention window used automatically in HIPAA mode (default: 30)
HIPAA_RETENTION_DAYS=
# GDPR auto-purge window for call data, in days (default: 90)
DATA_RETENTION_DAYS=
# Spoken recording/AI disclosure at call start. Default ON; set "false" to disable.
RECORDING_DISCLOSURE_ENABLED=
# Override the default disclosure wording.
RECORDING_DISCLOSURE_TEXT=
# DEV ONLY — "true" skips the outbound compliance gate (DNC/TCPA/calling window).
# Hard-ignored in production; never set this on a deployed environment.
BYPASS_COMPLIANCE=

# --- Rate limits (all optional, fixed-window, per process) ---
OUTBOUND_CALL_RATE_LIMIT=            # max outbound calls per window (default 30)
OUTBOUND_CALL_RATE_WINDOW_MS=        # window in ms (default 60000)
AGENT_TEST_CALL_RATE_LIMIT=          # browser test calls (default 5)
AGENT_TEST_CALL_PHONE_RATE_LIMIT=    # real test calls to a phone (default 3)
AGENT_TEST_CHAT_RATE_LIMIT=          # text-only test turns (default 15)
SYNTHETIC_TEST_RATE_LIMIT=           # synthetic scenario runs (default 5)
VOICE_PREVIEW_RATE_LIMIT=            # TTS voice previews (default 20)
WEBHOOK_TEST_RATE_LIMIT=             # webhook test sends (default 10)
KB_INGEST_RATE_LIMIT=                # knowledge-base ingests (default 5)
WORKFLOW_AI_DRAFT_RATE_LIMIT=        # AI workflow drafts (default 5)
APP_EVENTS_RATE_LIMIT=               # client telemetry events (default 120)

# --- Background sweeps ---
# Org inactivity lifecycle (voice/workflows/org-lifecycle-sweep.ts)
ORG_INACTIVITY_SUSPEND_DAYS=         # active -> suspended after N idle days (default 30)
ORG_INACTIVITY_CLOSE_DAYS=           # suspended -> closed after N idle days (default 60)
# Shopify retry cadences (voice/retry-config.ts) — the *_DELAY_MINUTES above are the first
# attempt; these are the gap between retries.
SHOPIFY_CART_RECOVERY_RETRY_DELAY_MINUTES=   # default 60
SHOPIFY_COD_RETRY_DELAY_MINUTES=             # default 30

# --- Synthetic caller (offline scenario harness) ---
SYNTHETIC_CALLER_PROVIDER=           # "groq" or unset for the gateway
SYNTHETIC_CALLER_MODEL=              # default openai/gpt-5.4-mini

# --- Runtime / logging ---
# HTTP port the API binds to (default 3000; the local dev script uses 4200)
PORT=
# "json" (default in production) or "console"
LOG_FORMAT=
# debug | info | warn | error
LOG_LEVEL=

# --- Frontend (build-time, Vite) ---
# Supabase Auth from the browser — the anon key, never the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# "true" mounts the local UI harness routes (/__harness, /__preview). Dev/CI only.
VITE_UI_HARNESS=

# Platform-injected, never set by hand: CI, DEV, RAILWAY_GIT_COMMIT_SHA,
# RAILWAY_REPLICA_REGION, VITE_USER_NODE_ENV.
