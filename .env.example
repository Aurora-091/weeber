NODE_ENV=development

# Database — Supabase Postgres (ADR-034). Use the pooled (transaction-mode,
# port 6543) connection string from the Supabase dashboard; auth lives
# inside the URL.
DATABASE_URL=

# AI Gateway (LLM) — e.g. Vercel AI Gateway: https://ai-gateway.vercel.sh/v1
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
# Optional — gateway model id (default: openai/gpt-5.4-mini)
AI_GATEWAY_MODEL=

# Deepgram (real-time speech-to-text)
DEEPGRAM_API_KEY=

# ElevenLabs (real-time text-to-speech)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public HTTPS URL Twilio can reach (wss derived automatically for the media stream)
# — this is the API's OWN origin (Railway), not a browser-facing site.
PUBLIC_APP_URL=

# Browser-facing marketing-site origin — used for links that must land on a
# web page a human opens (e.g. waitlist referral links). Distinct from
# PUBLIC_APP_URL on split deploys, where the API origin serves no frontend.
PUBLIC_WEB_URL=https://www.weeber.ai

# Browser-facing MERCHANT app origin — used for links that must land on the
# merchant dashboard specifically (e.g. weebersh's Shopify OAuth return_url,
# see buildInstallUrl in voice/org-queries.ts). Distinct from PUBLIC_WEB_URL
# (marketing site) and PUBLIC_APP_URL (this API's own origin) — a merchant
# finishing Shopify OAuth needs to land on app.weeber.ai, not either of
# those. Falls back to PUBLIC_APP_URL if unset, which is wrong on any real
# split deploy (dead link, no frontend behind that origin) — always set
# this explicitly in production.
PUBLIC_MERCHANT_APP_URL=https://app.weeber.ai

# --- Backend/frontend split deploy (ADR-035) ---
# Backend side: comma-separated origin allowlist for CORS. Unset = reflect any
# origin (single-deploy behavior). Set before the Vercel frontend goes live.
CORS_ALLOWED_ORIGINS=https://www.weeber.ai,https://admin.weeber.ai,https://app.weeber.ai
# Frontend side (build-time, Vite): the Railway backend's origin. Unset =
# same-origin (single-deploy). Set in Vercel's env, not Railway's.
VITE_API_BASE_URL=

# Optional — default webhook target for n8n/Zapier/Make call-event notifications
WEBHOOK_URL=

# Object storage (Tigris/S3-compatible), if using file uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Legacy bootstrap admin key — always accepted alongside labeled admin keys, never removed
ADMIN_API_KEY=

# Optional — Redis-backed session storage for running more than one instance.
# Leave unset to keep the default in-memory session store (zero behavior change).
REDIS_URL=

# --- Weeber Shopify vertical (ADR-030) ---
# Shared secrets with the weebersh connector app (github.com/Aurora-091/weebersh)
# — see docs/contract.md. Distinct secrets per direction so each can be rotated
# independently.
WEEBER_INTERNAL_SECRET=
WEEBER_CALLBACK_SECRET=
WEEBERSH_APP_URL=
# weebersh's Shopify app OAuth entrypoint (e.g. https://weebersh.up.railway.app/auth/shopify)
WEEBERSH_INSTALL_URL=

# Shopify vertical playbook tuning (all optional, sane defaults in code)
SHOPIFY_CART_RECOVERY_DELAY_MINUTES=45
SHOPIFY_CART_RECOVERY_MAX_ATTEMPTS=2
SHOPIFY_COD_DELAY_MINUTES=30
SHOPIFY_COD_MAX_ATTEMPTS=3
SHOPIFY_FEEDBACK_DELAY_DAYS=3

# --- Supabase (Storage + Auth today; primary Postgres DB once the ADR-034 migration lands) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KB_BUCKET=kb-documents
# Optional: HS256 shared secret for pre-2025 Supabase projects. When unset,
# user JWT verification falls back to JWKS (asymmetric, via SUPABASE_URL).
# SUPABASE_JWT_SECRET=

# --- Resend (transactional email) ---
# API key from Resend dashboard; when unset, transactional emails silently skip.
RESEND_API_KEY=
# Verified sender (default: hello@weeber.ai)
RESEND_FROM_EMAIL=hello@weeber.ai

# --- Frontend build-time surface control ---
# "all" (default) = single bundle with all routes (landing + admin + user).
# "public" = marketing pages only (landing, docs).
# "admin" = /dashboard/* only (internal admin panel).
# "user" = /app/* only (user-facing product).
# Use separate Vercel projects per surface for subdomain isolation.
VITE_APP_SURFACE=all

# --- Cross-subdomain origins (production only, leave unset in local dev) ---
# Set these per Vercel project so cross-surface links resolve correctly.
# Unset = same-origin relative paths (local dev / VITE_APP_SURFACE=all).
VITE_WWW_ORIGIN=https://www.weeber.ai
VITE_ADMIN_ORIGIN=https://admin.weeber.ai
VITE_APP_ORIGIN=https://app.weeber.ai

# --- Crawler indexing (production only) ---
# Static <meta name="robots"> content baked into index.html at build time (Vite's
# %VAR% HTML env replacement) + drives vite.config.ts's robots.txt generation.
# Default here is the permissive public-marketing value. The admin and user
# Vercel projects MUST override this to "noindex, nofollow" -- their pages should
# never be indexed, and once they serve bare paths (no /dashboard or /app prefix)
# the shared public robots.txt's path-based Disallow rules no longer cover them.
VITE_ROBOTS_META=index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1

