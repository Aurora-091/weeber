{
  "mcpServers": {
    "shopify-dev-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@shopify/dev-mcp@latest"],
      "env": {}
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=wtqohdcghmxuujqyhlkz"
    },
    "twilio": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@twilio-alpha/mcp"],
      "env": {
        "ACCOUNT_SID": "${TWILIO_ACCOUNT_SID}",
        "AUTH_TOKEN": "${TWILIO_AUTH_TOKEN}"
      }
    },
    "railway": {
      "type": "http",
      "url": "https://mcp.railway.com"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    }
  }
}
