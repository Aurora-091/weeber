# Pinned environment for the VISUAL + A11Y suites. Committed on purpose.
#
# WHY THIS FILE EXISTS
# playwright.visual.config.ts builds the real bundle and screenshots it. Before
# this file, that build read whatever `.env` happened to be on the machine, which
# made the 78 pixel baselines a function of the developer's local config. The
# first CI run proved it: CI has no `.env`, so `VITE_SUPABASE_URL` and
# `VITE_SUPABASE_ANON_KEY` were unset, `lib/supabase.ts` set
# supabaseConfigured=false, and /app/login rendered its one-line "User login
# isn't configured" notice instead of the sign-in form. That was 3 visual
# failures (~18,700 px each) plus the a11y floor tripping at 6 rules applied
# against a minimum of 12 — because axe on a one-sentence page really does apply
# almost no rules.
#
# So every VITE_* key the app reads is pinned here, not just the two that broke.
# Vite loads `.env` first and `.env.visual` second, so these WIN over a local
# `.env` and the built bundle is identical on every machine.
#
# NOT SECRETS. These are fixtures. e2e-visual/_settle.ts aborts every off-origin
# request, so nothing here is ever dialled — the Supabase values exist only to
# get `supabaseConfigured === true` so the real login form renders.
# Never put a real credential in this file: it is committed.
#
# VITE_UI_HARNESS is deliberately absent — playwright.visual.config.ts sets it
# inline for exactly one build, and vite.config.ts pins it to "0" everywhere else
# so the harness folds out of production output as dead code.

VITE_SUPABASE_URL=https://visual-fixture.supabase.invalid
VITE_SUPABASE_ANON_KEY=visual-fixture-anon-key-not-a-real-credential

VITE_API_BASE_URL=
VITE_APP_SURFACE=all
VITE_WWW_ORIGIN=
VITE_ADMIN_ORIGIN=
VITE_APP_ORIGIN=
VITE_ROBOTS_META="noindex, nofollow"
