{
  "name": "weeber",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd packages/web && bunx vite",
    "start": "pm2 delete web-app 2>/dev/null || true; pm2 start ecosystem.config.cjs --update-env",
    "start:railway": "cd packages/api && bunx drizzle-kit migrate && bun run src/server.ts",
    "build": "cd packages/web && npx tsc -b && npx vite build",
    "build:web": "cd packages/web && npx vite build",
    "lint": "oxlint . --deny-warnings --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --deny-warnings --no-error-on-unmatched-pattern",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "db:studio": "turbo db:studio",
    "kill:port": "lsof -t -i :${PORT:-4200} | xargs kill -9",
    "contrast:gate": "bun tools/ui-guard/contrast-gate.ts",
    "design:guard": "bun tools/ui-guard/design-guard.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/semver": "^7.7.1",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "semver": "^7.7.2",
    "turbo": "2.9.18",
    "typescript": "5.9.3",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "pm2": "^7.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "esbuild": "^0.25.12"
  }
}
