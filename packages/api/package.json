{
  "name": "@weeber/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate src/",
    "lint": "cd ../.. && oxlint packages/api --deny-warnings --no-error-on-unmatched-pattern",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env drizzle-kit push",
    "db:studio": "bun --env-file=../../.env drizzle-kit studio",
    "bench:latency": "bun --env-file=../../.env run scripts/latency-benchmark.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.5",
    "@openvent/compliance": "*",
    "ai": "^7.0.15",
    "dedent": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "^4.12.10",
    "ioredis": "^5.11.1",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.7",
    "twilio": "^6.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.3.5",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.8.3"
  }
}
