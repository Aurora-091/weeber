{
  "name": "@weeber/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate src/",
    "test:coverage": "bun test --isolate src/ --coverage",
    "test:e2e": "playwright test",
    "lint": "cd ../.. && oxlint packages/web --deny-warnings --no-error-on-unmatched-pattern",
    "preview": "bun run build && vite preview",
    "test:visual": "playwright test -c playwright.visual.config.ts visual.spec.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts visual.spec.ts --update-snapshots",
    "test:a11y": "playwright test -c playwright.visual.config.ts a11y.spec.ts"
  },
  "dependencies": {
    "@runablehq/website-runtime": "^0.10.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tanstack/react-query": "^5.100.6",
    "@weeber/api": "*",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hono": "^4.12.10",
    "lucide-react": "^0.577.0",
    "motion": "^12.42.2",
    "radix-ui": "^1.6.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "wouter": "^3.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@happy-dom/global-registrator": "^20.11.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/node": "^25.3.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.1.4",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.1"
  }
}
